{
  "name": "@ragenai/ragen-token-vault",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "generate:types": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "prisma generate && tsc --noEmit",
    "verify": "npm run generate:types && npm run lint && npm run test:run && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
