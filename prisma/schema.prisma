generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Token {
  id             String    @id @default(uuid()) @db.Uuid
  customer_id    String
  provider       String

  // Encrypted (AES-256-GCM, stored as "iv_hex:ciphertext_b64:tag_hex")
  access_token   String
  refresh_token  String?
  client_id      String?
  client_secret  String?
  code_verifier  String?

  // Metadata (not encrypted)
  token_type     String    @default("Bearer")
  expires_at     DateTime? @db.Timestamptz
  scopes         String?
  token_uri      String?

  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz

  @@unique([customer_id, provider])
  @@index([customer_id])
  @@map("tokens")
}

model OAuthPendingState {
  state         String   @id
  customer_id   String
  provider      String
  redirect_uri  String?
  code_verifier String?
  scopes        String?
  created_at    DateTime @default(now()) @db.Timestamptz
  expires_at    DateTime @db.Timestamptz

  @@map("oauth_pending_states")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  customer_id    String
  provider       String
  action         String
  caller_service String
  metadata       Json?
  created_at     DateTime @default(now()) @db.Timestamptz

  @@index([customer_id])
  @@index([created_at])
  @@map("audit_logs")
}
