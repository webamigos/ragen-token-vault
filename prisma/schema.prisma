generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Token {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @map("customer_id")
  provider      String

  // Encrypted (AES-256-GCM, stored as "iv_hex:ciphertext_b64:tag_hex")
  accessToken   String    @map("access_token")
  refreshToken  String?   @map("refresh_token")
  clientId      String?   @map("client_id")
  clientSecret  String?   @map("client_secret")
  codeVerifier  String?   @map("code_verifier")

  // Metadata (not encrypted)
  tokenType     String    @default("Bearer") @map("token_type")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  scopes        String?
  tokenUri      String?   @map("token_uri")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([customerId, provider])
  @@index([customerId])
  @@map("tokens")
}

model OAuthPendingState {
  state        String   @id
  customerId   String   @map("customer_id")
  provider     String
  redirectUri  String?  @map("redirect_uri")
  codeVerifier String?  @map("code_verifier")
  scopes       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz

  @@map("oauth_pending_states")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id")
  provider      String
  action        String
  callerService String   @map("caller_service")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([customerId])
  @@index([createdAt])
  @@map("audit_logs")
}
